# Link de invitación a Slack (el botón "¡Únete!")
VITE_SLACK_INVITE_LINK=https://join.slack.com/t/devschile/shared_invite/...

# PostHog Analytics (browser)
# Mismo proyecto que el resto de los sitios de devsChile: los eventos se
# filtran por la propiedad `site`, no por host.
VITE_POSTHOG_KEY=phc_tu_project_token_aqui
# Opcional. Por defecto: https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
